rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ─── Helper functions ───
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAllowedUser() {
      return isAuthenticated() &&
             exists(/databases/$(database)/documents/allowed_emails/$(request.auth.token.email));
    }

    // ─── Users collection ───
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    // ─── Allowed emails whitelist ───
    match /allowed_emails/{emailId} {
      allow read: if isAuthenticated();
      allow write: if isAllowedUser();
    }

    // ─── Initial balances ───
    match /initial_balances/{balanceId} {
      allow read, write: if isAllowedUser();
    }

    // ─── Expenses ───
    match /expenses/{expenseId} {
      allow read: if isAllowedUser();
      allow create: if isAllowedUser()
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.currency in ['USD', 'EGP']
        && request.resource.data.split_type in ['default_100', 'fifty_fifty', 'custom']
        && request.resource.data.me_percentage is number
        && request.resource.data.friend_percentage is number
        && (request.resource.data.me_percentage + request.resource.data.friend_percentage) > 99.9
        && (request.resource.data.me_percentage + request.resource.data.friend_percentage) < 100.1;
      allow update: if isAllowedUser()
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.currency in ['USD', 'EGP']
        && request.resource.data.split_type in ['default_100', 'fifty_fifty', 'custom'];
      allow delete: if isAllowedUser();
    }

    // ─── Exchanges ───
    match /exchanges/{exchangeId} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser()
        && request.resource.data.from_amount is number
        && request.resource.data.from_amount > 0
        && request.resource.data.to_amount is number
        && request.resource.data.to_amount > 0
        && request.resource.data.from_currency in ['USD', 'EGP']
        && request.resource.data.to_currency in ['USD', 'EGP']
        && request.resource.data.from_currency != request.resource.data.to_currency;
      allow delete: if isAllowedUser();
    }

    // ─── Borrows ───
    match /borrows/{borrowId} {
      allow read: if isAllowedUser();
      allow create, update: if isAllowedUser()
        && request.resource.data.usd_amount is number
        && request.resource.data.usd_amount >= 0
        && request.resource.data.egp_amount is number
        && request.resource.data.egp_amount >= 0
        && (request.resource.data.usd_amount > 0 || request.resource.data.egp_amount > 0);
      allow delete: if isAllowedUser();
    }
  }
}
